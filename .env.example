# Скопируйте в .env рядом с docker-compose.yml и измените значения.
# Эти имена совпадают с тем, что удобно задавать вручную; на Railway чаще даётся DATABASE_URL.

POSTGRES_DB=carsharing
POSTGRES_USER=postgres
DB_PASSWORD=замените_на_свой_пароль

# Опционально (то же самое, что задаёт клиент libpq / часть шаблонов Railway):
# PGDATABASE=carsharing
# PGUSER=postgres
# PGPASSWORD=замените_на_свой_пароль

APP_PORT=8080

# Локально true — загрузка демо-данных при старте. На Railway с профилем prod по умолчанию false.
# APP_SEED_ENABLED=true
