<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console only: PaaS (Railway) and Docker non-root users have no writable logs/ directory. -->

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.example.carsharing1.aspect" level="INFO"/>
    <logger name="com.example.carsharing1.service" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
